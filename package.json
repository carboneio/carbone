{
  "name": "carbone",
  "description": "Fast, Simple and Powerful report generator. Injects JSON and produces PDF, DOCX, XLSX, ODT, PPTX, ODS, ...!",
  "version": "3.9.2",
  "bin": "bin/carbone",
  "main": "./lib",
  "author": "David Grelaud",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://carbone.io",
  "keywords": [
    "report",
    "document",
    "pdf",
    "xslx",
    "docx",
    "odt",
    "ods",
    "json"
  ],
  "scripts": {
    "test": "./node_modules/.bin/mocha test --timeout 100000 --exit",
    "lint": "eslint ./lib/**.js ./test/**.js ./formatters/**.js",
    "lint:fix": "eslint ./lib/**.js ./test/**.js ./formatters/**.js --fix",
    "postpublish": "git tag $npm_package_version && git push origin $npm_package_version"
  },
  "dependencies": {
    "@carboneio/yazl": "=3.3.2",
    "dayjs": "=1.11.23",
    "debug": "=4.4.3",
    "which": "=6.0.1",
    "yauzl": "=3.4.0"
  },
  "devDependencies": {
    "mocha": "=9.2.2"
  },
  "overrides": {
    "yargs": "=16.2.2"
  },
  "engines": {
    "node": ">= 12.14.0"
  }
}
